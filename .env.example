AUTH_SECRET=change-me-to-a-long-random-string

# Spirit LLM coach (Vercel AI Gateway — recommended)
# Get a key: https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Optional: override default fitness model (default: openai/gpt-5.4)
# GARANIMAL_AI_MODEL=openai/gpt-5.4

# Legacy fallback: OpenAI-compatible endpoint (if not using AI Gateway)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
