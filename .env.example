AUTH_SECRET=change-me-to-a-long-random-string

# Spirit LLM coach (Vercel AI Gateway — recommended)
# Get a key: https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Optional model routing (provider/model format)
# GARANIMAL_AI_MODEL=openai/gpt-5.4
# GARANIMAL_LIVE_MODEL=openai/gpt-5.4      # mid-set advice (fast path)
# GARANIMAL_CHAT_MODEL=openai/gpt-5.4      # coach chat + briefings

# Hugging Face — enables semantic KB search (sentence-transformers/all-MiniLM-L6-v2)
# Pattern from: https://huggingface.co/sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=
# GARANIMAL_HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# SuperByte-style multi-read consensus for high-risk sets (1–3)
# SPIRIT_READS=2

# Legacy fallback: OpenAI-compatible endpoint (if not using AI Gateway)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
